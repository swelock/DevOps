{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Тесты: понятный отчёт",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["-m", "pytest", "-q", "--explain", "--color=yes"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "test", "isDefault": true},
      "presentation": {"reveal": "always", "panel": "dedicated", "clear": true},
      "problemMatcher": []
    },
    {
      "label": "Проект: полная проверка",
      "type": "process",
      "command": "make",
      "args": ["verify"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": "test",
      "presentation": {"reveal": "always", "panel": "dedicated", "clear": true},
      "problemMatcher": []
    }
  ]
}
