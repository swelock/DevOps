APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_ENGINE=sqlite
DATABASE_PATH=instance/campus.sqlite3
# Для Linux-развёртывания задайте значения в /etc/campus/campus.env, а не здесь:
# DATABASE_HOST=192.168.56.20
# DATABASE_PORT=5432
# DATABASE_NAME=campus
# DATABASE_USER=campus_app
# DATABASE_PASSWORD=<задаётся вне репозитория>

# Сгенерируйте собственное значение: python3 -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=<REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS>
# true только при доступе через HTTPS; для локального HTTP оставьте false.
SESSION_COOKIE_SECURE=false
